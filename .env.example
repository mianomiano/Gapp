# ── Telegram bot ──────────────────────────────────────────────
# Create a bot with @BotFather, then paste its token here.
# Required for the "Send Stars" / "Unlock" donations to work.
BOT_TOKEN=

# ── Admin panel ───────────────────────────────────────────────
# The password you type to log in at /admin. Pick anything you like.
ADMIN_PASSWORD=change-me

# ── Session signing ───────────────────────────────────────────
# Any long random string. Used to sign the admin login cookie.
SECRET_KEY=put-a-long-random-string-here

# ── Optional ──────────────────────────────────────────────────
# Port the app listens on (default 5000). Railway sets this for you.
PORT=5000

# ── Hosting on an ephemeral filesystem (Railway, Fly, Render) ──
# These hosts wipe the container on every redeploy. Leave the whole
# section blank to run from local disk, which is what you want on your
# own machine or on a normal server.

# Where the SQLite file lives. Point this at a mounted volume in
# production, or every deploy starts from an empty gallery.
#   Railway: attach a volume at /data, then set DB_PATH=/data/gallery.db
DB_PATH=

# ── Cloudflare R2 (uploaded media) ─────────────────────────────
# All five must be set together; any missing one falls back to local disk.
# From the Cloudflare dashboard: R2 → Manage API Tokens → Create token
# with Object Read & Write on your bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Public base URL for the bucket — either the r2.dev development URL or
# your own domain connected to it. No trailing slash.
#   e.g. https://pub-xxxxxxxx.r2.dev
R2_PUBLIC_URL=
